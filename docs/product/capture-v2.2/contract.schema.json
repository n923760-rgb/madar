{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:madar:capture-understanding:2.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "disposition",
    "items",
    "questions",
    "user_message"
  ],
  "properties": {
    "schema_version": {
      "const": "madar.capture-understanding/2.2"
    },
    "capture_id": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "enum": [
        "ready",
        "clarify",
        "retrieve",
        "keep_source",
        "unsupported",
        "restricted"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "intent",
          "status",
          "fields"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "enum": [
              "task",
              "appointment",
              "reminder",
              "invoice",
              "document",
              "subscription",
              "maintenance",
              "odometer",
              "note",
              "retrieval",
              "correction",
              "unsupported",
              "restricted"
            ]
          },
          "status": {
            "enum": [
              "ready",
              "needs_clarification",
              "source_only",
              "blocked"
            ]
          },
          "fields": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "value",
                "confidence",
                "evidence",
                "resolver"
              ],
              "properties": {
                "key": {
                  "enum": [
                    "title",
                    "date",
                    "time",
                    "timezone",
                    "all_day",
                    "original_time_phrase",
                    "reminder_requested",
                    "recurrence",
                    "amount_minor",
                    "currency",
                    "merchant",
                    "object_id",
                    "object_name",
                    "odometer",
                    "interval_km",
                    "next_odometer",
                    "expiry_date",
                    "warranty_months",
                    "content",
                    "query",
                    "target_id",
                    "invoice_route",
                    "object_resolution"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "integer",
                    "boolean",
                    "null"
                  ]
                },
                "confidence": {
                  "enum": [
                    "source",
                    "derived",
                    "uncertain",
                    "missing"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source_id",
                      "quote"
                    ],
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "resolver": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "field",
          "text"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "enum": [
              "title",
              "date",
              "time",
              "timezone",
              "all_day",
              "original_time_phrase",
              "reminder_requested",
              "recurrence",
              "amount_minor",
              "currency",
              "merchant",
              "object_id",
              "object_name",
              "odometer",
              "interval_km",
              "next_odometer",
              "expiry_date",
              "warranty_months",
              "content",
              "query",
              "target_id",
              "invoice_route",
              "object_resolution"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "user_message": {
      "type": "string",
      "minLength": 1
    }
  }
}
